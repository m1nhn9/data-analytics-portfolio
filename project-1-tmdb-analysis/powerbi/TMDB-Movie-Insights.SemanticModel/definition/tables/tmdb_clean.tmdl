		sourceColumn: release_date

		variation Variation
			isDefault
			relationship: 0b10d832-9505-4f2f-b981-ff1543551267
			defaultHierarchy: LocalDateTable_18118ef3-3f6c-4300-ad93-e467c3bcc5ff.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column year
