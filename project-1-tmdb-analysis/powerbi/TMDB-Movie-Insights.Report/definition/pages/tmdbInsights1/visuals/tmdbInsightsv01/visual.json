          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Key findings",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#01B4E4"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▸ ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#01B4E4"
                    }
                  },
                  {
                    "value": "Popularity is not quality. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#0D253F"
                    }
                  },
                  {
                    "value": "Across 3,981 reliably rated films, popularity barely predicts rating (Pearson r 0.079, Spearman ρ 0.230, computed in Python).",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#4A5A6A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▸ ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#01B4E4"
                    }
                  },
                  {
                    "value": "Evergreen films come from the 1990s–2000s. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#0D253F"
                    }
                  },
                  {
                    "value": "55 of the 86 evergreen titles (64%) were released in those two decades; none yet from the 2010s or 2020s.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#4A5A6A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▸ ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#01B4E4"
                    }
                  },
                  {
                    "value": "One upcoming release dominates the buzz. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#0D253F"
                    }
                  },
                  {
                    "value": "Your Heart Will Be Broken scores 1,341 popularity, 3.5× the next upcoming film (Mike & Nick & Nick & Alice, 383).",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#4A5A6A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▸ ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#01B4E4"
                    }
                  },
                  {
                    "value": "Recent ratings are not settled. ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#0D253F"
                    }
                  },
                  {
                    "value": "Median votes fall from ~2,800 (2018) to near zero (2026), so 2025–26 averages rest on few votes (survivorship bias).",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#4A5A6A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▸ ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#01B4E4"
                    }
                  },
                  {
                    "value": "62 hidden gems ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontWeight": "bold",
                      "color": "#0D253F"
                    }
                  },
                  {
                    "value": "are rated 8.0–9.4 but have popularity below 6: strong candidates for curation.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#4A5A6A"
                    }
                  }
                ]
              }
            ]
